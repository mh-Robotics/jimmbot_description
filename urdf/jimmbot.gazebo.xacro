<?xml version="1.0"?>
<robot name="jimmbot_simulation" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="enable_control" default="true" />

  <!-- Kinect front -->
  <gazebo reference="kinect_front_link">
    <sensor type="depth" name="kinect_front">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <topic>/kinect_front/depth/image_raw</topic>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Kinect back -->
  <gazebo reference="kinect_back_link">
    <sensor type="depth" name="kinect_back">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <topic>/kinect_back/depth/image_raw</topic>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_base">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>/imu</topic>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_frame">
    <sensor type="ray" name="ydlidar_sensor">
      <update_rate>12.0</update_rate>
      <visualize>false</visualize>
      <topic>/laserscan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="gps_front_base">
    <sensor name="gps_front_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <topic>/gps/fix_front</topic>
    </sensor>
  </gazebo>

  <gazebo reference="gps_back_base">
    <sensor name="gps_back_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <topic>/gps/fix_back</topic>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_control)">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find jimmbot_controller)/config/gz_ros2_control.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- NOTE: Gazebo Classic ROS plugins were removed for ROS 2 + Gazebo Sim bringup.
       Equivalent ROS topic delivery is now expected through ros_gz_bridge.
       Control interfaces now use ros2_control + gz_ros2_control plugin. -->

</robot>