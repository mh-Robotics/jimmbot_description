<?xml version="1.0"?>
<robot name="jimmbot_simulation" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Kinect front (Gazebo Sim format) -->
  <gazebo reference="kinect_front_link">
    <sensor name="kinect_front" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Kinect back (Gazebo Sim format) -->
  <gazebo reference="kinect_back_link">
    <sensor name="kinect_back" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_base">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_frame">
    <sensor type="lidar" name="ydlidar_sensor">
      <always_on>true</always_on>
      <update_rate>12.0</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="gps_front_base">
    <sensor name="gps_front_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
    </sensor>
  </gazebo>

  <gazebo reference="gps_back_base">
    <sensor name="gps_back_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

  <!-- NOTE: Control plugin is configured by jimmbot_gazebo launch files.
       Gazebo Classic ROS plugins were removed for ROS 2 + Gazebo Sim bringup.
       Equivalent ROS topic delivery is now handled through ros_gz_bridge.
       Control interfaces use ros2_control + gz_ros2_control plugin configured in gazebo launches. -->

</robot>