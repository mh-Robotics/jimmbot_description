<?xml version="1.0"?>
<robot name="jimmbot_simulation" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="gz_control_params_file" default="gz_control.yaml" />

  <!-- Kinect front (Gazebo Sim format) -->
  <gazebo reference="kinect_front_link">
    <sensor name="kinect_front" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <frame_id>kinect_front_link</frame_id>
      <topic>/kinect_front/depth/image_raw</topic>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor name="kinect_front_rgb" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <frame_id>kinect_front_link</frame_id>
      <topic>/kinect_front/rgb/image_raw</topic>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Kinect back (Gazebo Sim format) -->
  <gazebo reference="kinect_back_link">
    <sensor name="kinect_back" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <frame_id>kinect_back_link</frame_id>
      <topic>/kinect_back/depth/image_raw</topic>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor name="kinect_back_rgb" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <frame_id>kinect_back_link</frame_id>
      <topic>/kinect_back/rgb/image_raw</topic>
      <camera>
        <horizontal_fov>${60.0*3.14/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_base">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <frame_id>imu_base</frame_id>
      <visualize>false</visualize>
      <topic>/imu</topic>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_frame">
    <sensor type="gpu_lidar" name="ydlidar_sensor">
      <always_on>true</always_on>
      <update_rate>12.0</update_rate>
      <frame_id>lidar_frame</frame_id>
      <visualize>false</visualize>
      <topic>/laserscan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="gps_front_base">
    <sensor name="gps_front_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <topic>/gps/fix_front</topic>
    </sensor>
  </gazebo>

  <gazebo reference="gps_back_base">
    <sensor name="gps_back_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <topic>/gps/fix_back</topic>
    </sensor>
  </gazebo>

  <!-- Add explicit wheel traction/contact parameters so the robot grips the ground. -->
  <gazebo reference="wheel_front_left">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="wheel_front_right">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="wheel_back_left">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="wheel_back_right">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher" />
  </gazebo>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg gz_control_params_file)</parameters>
    </plugin>
  </gazebo>

  <!-- ROS 2 control interfaces are declared in jimmbot.xacro (ros2_control block).
       This Gazebo Sim plugin exposes those interfaces through /controller_manager. -->

</robot>